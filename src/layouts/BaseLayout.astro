---
import SiteShell from '../components/shell/SiteShell.astro';

interface Props {
  title: string;
  description?: string;
  activeSection?: 'projects' | 'fieldwork' | 'about' | '';
  author?: string;
  type?: string;
  seoTitle?: string;
  ogTitle?: string;
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, activeSection = '', author, type, seoTitle, ogTitle, ogImage, twitterCard, robots, structuredData } = Astro.props;
---
<SiteShell title={title} description={description} activeSection={activeSection} author={author} type={type} seoTitle={seoTitle} ogTitle={ogTitle} ogImage={ogImage} twitterCard={twitterCard} robots={robots} structuredData={structuredData}><slot /></SiteShell>
