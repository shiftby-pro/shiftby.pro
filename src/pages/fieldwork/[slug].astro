---
import FieldworkArticle from '../../components/fieldwork/FieldworkArticle.astro';
import { getCollection, render } from 'astro:content';
import { getFieldworkCanonicalPath } from '../../lib/fieldwork';

export async function getStaticPaths() {
  const items = await getCollection('fieldwork', ({ data }) => data.visibility === 'public');
  return items.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const canonicalPath = getFieldworkCanonicalPath(item);

if (canonicalPath !== `/fieldwork/${item.data.slug}/`) {
  return Astro.redirect(canonicalPath, 301);
}

const { Content } = await render(item);
---
<FieldworkArticle item={item}><Content /></FieldworkArticle>
