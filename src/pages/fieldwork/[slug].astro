---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('fieldwork', ({ data }) => data.visibility === 'public');
  return items.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title} description={item.data.description}>
  <article class="article">
    <header class="article-header">
      <p class="eyebrow">{item.data.format.replace('-', ' ')}</p>
      <h1>{item.data.title}</h1>
      <p class="lede">{item.data.description}</p>
      <dl class="meta">
        <div><dt>Project</dt><dd>{item.data.project}</dd></div>
        <div><dt>Author</dt><dd>{item.data.author.replaceAll('-', ' ')}</dd></div>
      </dl>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
