---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/project-fieldwork-hubs.css';
import { getFieldworkCanonicalPath, isPublishedIndexable, sortFieldworkByPublication } from '../../lib/fieldwork';

const publicItems = sortFieldworkByPublication(await getCollection('fieldwork', ({ data }) => isPublishedIndexable(data)));

const projectDetails: Record<string, { name: string; description: string; projectPath: string; archivePath: string }> = {
  inspiral: {
    name: 'Inspiral',
    description: 'Persistent understanding for AI-assisted work.',
    projectPath: '/projects/inspiral/',
    archivePath: '/projects/inspiral/fieldwork/',
  },
};

const itemsByProject = publicItems.reduce<Record<string, typeof publicItems>>((groups, item) => {
  if (item.data.project) (groups[item.data.project] ??= []).push(item);
  return groups;
}, {});

const featuredProject = 'inspiral';
const featuredDetails = projectDetails[featuredProject];
const featuredProjectItems = itemsByProject[featuredProject] ?? [];
// Recent notes are publication-wide; the featured collection remains the
// project summary on the left. This keeps the global filters truthful as new
// projects are published.
const featuredItems = publicItems;
const otherProjects = Object.keys(itemsByProject).filter((project) => project !== featuredProject && projectDetails[project]);
const formatLabel = (format: string) => format.replace(/-/g, ' ');
const purposeLabel: Record<string, string> = { analyze: 'Analysis', explain: 'Explanation', document: 'Documentation', teach: 'Teaching', report: 'Report', reflect: 'Reflection' };
const projects = [...new Set(publicItems.map(({ data }) => data.project).filter(Boolean))] as string[];
const formats = [...new Set(publicItems.map(({ data }) => data.format))];
const practiceAreas = [...new Set(publicItems.map(({ data }) => data.practice_area))];
const statuses = [...new Set(publicItems.map(({ data }) => data.current_status))];
const domains = [...new Set(publicItems.flatMap(({ data }) => data.work_domains))];
---
<BaseLayout title="Fieldwork" description="Independent, evidence-bounded notes on AI-assisted research, systems and practice." activeSection="fieldwork">
  <article class="page-shell fieldwork-hub-page">
    <header class="page-intro fieldwork-hub-intro">
      <p class="kicker">Fieldwork</p>
      <h1>Fieldwork</h1>
      <p class="lede">Independent, evidence-bounded notes on AI-assisted research, systems and practice.</p>
    </header>

    <section class="fieldwork-collection" aria-labelledby="featured-collection">
      <div class="fieldwork-collection-summary">
        <p class="section-label">Featured project collection</p>
        <h2 id="featured-collection">{featuredDetails.name}</h2>
        <p>{featuredDetails.description}</p>
        <p class="status-label">Exploration · Active · {featuredProjectItems.length} {featuredProjectItems.length === 1 ? 'note' : 'notes'}</p>
        <a class="arrow-link" href={featuredDetails.projectPath}>Explore {featuredDetails.name}</a>
      </div>

      <div class="fieldwork-collection-notes" data-fieldwork-archive>
        <p class="section-label">Recent notes</p>
        <form class="fieldwork-filters" aria-label="Filter fieldwork notes">
          <label>Project<select data-filter="project"><option value="">All projects</option>{projects.map((project) => <option value={project}>{project.replaceAll('-', ' ')}</option>)}</select></label>
          <label>Format<select data-filter="format"><option value="">All formats</option>{formats.map((format) => <option value={format}>{formatLabel(format)}</option>)}</select></label>
          <label>Domain<select data-filter="domain"><option value="">All domains</option>{domains.map((domain) => <option value={domain}>{domain.replaceAll('-', ' ')}</option>)}</select></label>
          <label>Practice<select data-filter="practice"><option value="">All practices</option>{practiceAreas.map((practice) => <option value={practice}>{practice.replaceAll('-', ' ')}</option>)}</select></label>
          <label>Status<select data-filter="status"><option value="">All statuses</option>{statuses.map((status) => <option value={status}>{status.replaceAll('-', ' ')}</option>)}</select></label>
        </form>
        <p class="fieldwork-filter-count" data-filter-count>{publicItems.length} {publicItems.length === 1 ? 'note' : 'notes'}</p>
        <ol class="fieldwork-note-list" data-archive-list>
          {featuredItems.map((item) => (
              <li data-archive-item data-project={item.data.project ?? ''} data-format={item.data.format} data-domain={item.data.work_domains.join(' ')} data-practice={item.data.practice_area} data-status={item.data.current_status}>
              <a href={getFieldworkCanonicalPath(item)}>
                <span class="fieldwork-note-meta">{purposeLabel[item.data.editorial_purpose]} · {formatLabel(item.data.format)} · {item.data.project ?? 'Fieldwork'}</span>
                <strong>{item.data.title}</strong>
                <span>{item.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="fieldwork-filter-empty" data-filter-empty hidden>No published notes match these filters.</p>
        <nav class="fieldwork-pagination" aria-label="Fieldwork pages" data-pagination hidden>
          <button type="button" data-page-prev>Previous</button>
          <span data-page-status aria-live="polite"></span>
          <button type="button" data-page-next>Next</button>
        </nav>
        <a class="arrow-link" href={featuredDetails.archivePath}>All {featuredDetails.name} Fieldwork</a>
      </div>
    </section>

    {otherProjects.length > 0 && (
      <section class="other-fieldwork-collections" aria-labelledby="other-collections">
        <p class="section-label">Other project collections</p>
        <h2 id="other-collections">More fieldwork</h2>
        <ul>
          {otherProjects.map((project) => {
            const details = projectDetails[project];
            return <li><a href={details.archivePath}>{details.name}</a></li>;
          })}
        </ul>
      </section>
    )}

    <section class="future-collections future-collections-empty" aria-labelledby="future-collections">
      <p class="section-label">More projects soon</p>
      <h2 id="future-collections">Additional project collections will appear here as their fieldwork becomes public.</h2>
    </section>

    <aside class="fieldwork-boundary-rail" aria-label="Fieldwork boundary">
      <p class="section-label">Fieldwork boundary</p>
      <p>Fieldwork records observations, methods, evidence and limits. It is not a product roadmap, a promise of future capability, or a general performance claim.</p>
    </aside>
  </article>
</BaseLayout>

<script>
  const archive = document.querySelector('[data-fieldwork-archive]');
  if (archive) {
    const items = [...archive.querySelectorAll<HTMLElement>('[data-archive-item]')];
    const controls = [...archive.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const count = archive.querySelector('[data-filter-count]');
    const empty = archive.querySelector<HTMLElement>('[data-filter-empty]');
    const pagination = archive.querySelector<HTMLElement>('[data-pagination]');
    const prev = archive.querySelector<HTMLButtonElement>('[data-page-prev]');
    const next = archive.querySelector<HTMLButtonElement>('[data-page-next]');
    const pageStatus = archive.querySelector<HTMLElement>('[data-page-status]');
    const pageSize = 12;
    const params = new URLSearchParams(window.location.search);
    controls.forEach((control) => { control.value = params.get(control.dataset.filter ?? '') ?? ''; });
    let page = Math.max(1, Number(params.get('page') ?? '1') || 1);
    const update = () => {
      const values: Record<string, string> = Object.fromEntries(controls.map((control) => [control.dataset.filter ?? '', control.value]));
      const matching = items.filter((item) => Object.entries(values).every(([key, value]) => !value || (item.dataset[key] ?? '').split(' ').includes(value)));
      const matchingIndex = new Map(matching.map((item, index) => [item, index]));
      const pages = Math.max(1, Math.ceil(matching.length / pageSize));
      page = Math.min(page, pages);
      const start = (page - 1) * pageSize;
      items.forEach((item) => {
        const index = matchingIndex.get(item);
        item.hidden = index === undefined || index < start || index >= start + pageSize;
      });
      if (count) count.textContent = `${matching.length} ${matching.length === 1 ? 'note' : 'notes'}`;
      if (empty) empty.hidden = matching.length > 0;
      if (pagination) pagination.hidden = matching.length <= pageSize;
      if (pageStatus) pageStatus.textContent = `Page ${page} of ${pages}`;
      if (prev) prev.disabled = page <= 1;
      if (next) next.disabled = page >= pages;
    };
    const syncUrl = () => {
      const nextParams = new URLSearchParams();
      controls.forEach((control) => { if (control.value) nextParams.set(control.dataset.filter ?? '', control.value); });
      if (page > 1) nextParams.set('page', String(page));
      const query = nextParams.toString();
      window.history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    };
    controls.forEach((control) => control.addEventListener('change', () => { page = 1; syncUrl(); update(); }));
    prev?.addEventListener('click', () => { page -= 1; syncUrl(); update(); });
    next?.addEventListener('click', () => { page += 1; syncUrl(); update(); });
    update();
  }
</script>
