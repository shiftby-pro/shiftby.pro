---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('fieldwork', ({ data }) => data.visibility === 'public');
---
<BaseLayout title="Fieldwork" description="Canonical Shiftby.pro fieldwork publications.">
  <header class="article-header">
    <p class="eyebrow">Fieldwork</p>
    <h1>Projects, analyses and lessons from real AI-assisted work.</h1>
  </header>
  <ul class="card-list">
    {items.map((item) => (
      <li>
        <a href={`/fieldwork/${item.data.slug}/`}>
          <strong>{item.data.title}</strong>
          <span>{item.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
