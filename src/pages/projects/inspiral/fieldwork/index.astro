---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublishedIndexable, sortFieldworkByPublication } from '../../../../lib/fieldwork';
import { collectionStructuredData } from '../../../../lib/structured-data';

const items = sortFieldworkByPublication(await getCollection('fieldwork', ({ data }) =>
  isPublishedIndexable(data) && data.project === 'inspiral',
));
---
<BaseLayout title="Inspiral Fieldwork" description="Evidence-bounded fieldwork from Inspiral on preserving context, decisions, current state and human authority across AI-assisted work." ogImage={new URL('/images/social/inspiral.png', Astro.site).href} ogImageAlt="Inspiral Fieldwork on persistent understanding for AI-assisted work" twitterCard="summary_large_image" structuredData={collectionStructuredData(Astro.site, '/projects/inspiral/fieldwork/', 'Inspiral Fieldwork | Shiftby.pro', 'Evidence-bounded fieldwork from Inspiral on preserving context, decisions, current state and human authority across AI-assisted work.', items.map((item) => ({ name: item.data.title, url: new URL(`/projects/inspiral/fieldwork/${item.data.slug}/`, Astro.site).href })))}>
  <section class="hero">
    <p class="eyebrow">Inspiral / Fieldwork</p>
    <h1>Notes from an active exploration of trustworthy continuing work.</h1>
    <p class="lede">Analysis, evidence and build notes on preserving context, decisions, current state and human authority across AI-assisted work.</p>
  </section>
  <section aria-labelledby="fieldwork-notes">
    <p class="eyebrow">All notes</p>
    <h2 id="fieldwork-notes">Fieldwork archive</h2>
    <p class="lede">This archive follows one question: how can continuing AI-assisted work begin from trustworthy context instead of reconstructing it from prompts? Notes are categorized by purpose, format, practice area and current status, and distinguish observed evidence from interpretation and unresolved work.</p>
    <ul class="card-list">
      {items.map((item) => (
        <li>
          <a href={`/projects/inspiral/fieldwork/${item.data.slug}/`}>
            <strong>{item.data.title}</strong>
            <span>{item.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
