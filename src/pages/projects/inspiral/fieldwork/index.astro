---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublishedIndexable, sortFieldworkByPublication } from '../../../../lib/fieldwork';
import { collectionStructuredData } from '../../../../lib/structured-data';

const items = sortFieldworkByPublication(await getCollection('fieldwork', ({ data }) =>
  isPublishedIndexable(data) && data.project === 'inspiral',
));
const [featuredItem, ...supportingItems] = items;
const stageSequence = [
  ['01', 'Why the problem matters', 'The continuity problem behind the exploration.'],
  ['02', 'What must survive', 'The handoff conditions a later task needs to recover.'],
  ['03', 'How the work is supported', 'The bounded role of tools, code and human review.'],
  ['04', 'What exists now', 'A dated, inspectable view of the ContextCore foundation.'],
];
const pageDescription = 'Inspiral fieldwork hub: evidence-bounded notes on how trustworthy context is formed, carried forward and inspected across AI-assisted work.';
---
<BaseLayout title="Inspiral Fieldwork" description={pageDescription} activeSection="fieldwork" ogImage={new URL('/images/social/inspiral.png', Astro.site).href} ogImageAlt="Inspiral Fieldwork hub on carrying trustworthy context across AI-assisted work" twitterCard="summary_large_image" structuredData={collectionStructuredData(Astro.site, '/projects/inspiral/fieldwork/', 'Inspiral Fieldwork | Shiftby.pro', pageDescription, items.map((item) => ({ name: item.data.title, url: new URL(`/projects/inspiral/fieldwork/${item.data.slug}/`, Astro.site).href })))}>
  <article class="page-shell fieldwork-hub-page inspiral-fieldwork-hub">
    <header class="page-intro fieldwork-hub-intro">
      <p class="kicker">Inspiral / Fieldwork</p>
      <h1>Inspiral Fieldwork</h1>
      <p class="lede">A working hub for the question behind Inspiral: how can AI-assisted work continue from trustworthy context instead of reconstructing it from prompts?</p>
      <div class="hero-actions"><a class="arrow-link" href="/projects/inspiral/">Back to Inspiral</a><a class="arrow-link" href="/fieldwork/">All Shiftby.pro Fieldwork</a></div>
    </header>

    <section class="fieldwork-hub-purpose" aria-labelledby="hub-purpose">
      <div><p class="section-label">What this hub holds</p><h2 id="hub-purpose">Field notes from one connected exploration.</h2></div>
      <p>These notes follow the movement from the continuity problem, through handoff and tool-assisted implementation, to the current ContextCore working foundation. Each note separates observed evidence from interpretation, shows its limits and points to the next question.</p>
    </section>

    <section class="fieldwork-sequence" aria-labelledby="fieldwork-sequence-title">
      <p class="section-label">The fieldwork sequence</p><h2 id="fieldwork-sequence-title">One investigation, four views.</h2>
      <ol>{stageSequence.map(([number, title, description]) => <li><span>{number}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol>
    </section>

    {featuredItem && <section class="fieldwork-featured-note" aria-labelledby="featured-note-title">
      <div><p class="section-label">Start here</p><p class="fieldwork-featured-meta">{featuredItem.data.format.replaceAll('-', ' ')} · {featuredItem.data.current_status}</p></div>
      <div><h2 id="featured-note-title"><a href={`/projects/inspiral/fieldwork/${featuredItem.data.slug}/`}>{featuredItem.data.title}</a></h2><p>{featuredItem.data.featured_statement ?? featuredItem.data.description}</p><a class="arrow-link" href={`/projects/inspiral/fieldwork/${featuredItem.data.slug}/`}>Read the latest note</a></div>
    </section>}

    <section class="fieldwork-hub-notes" aria-labelledby="project-notes-title">
      <div class="fieldwork-hub-notes-heading"><div><p class="section-label">Notes in this exploration</p><h2 id="project-notes-title">Follow the thread.</h2></div><p>Read the notes in the order that best matches your question. They are part of one project record, not a general archive.</p></div>
      <ol class="fieldwork-note-list">{supportingItems.map((item) => <li><a href={`/projects/inspiral/fieldwork/${item.data.slug}/`}><span class="fieldwork-note-meta">{item.data.format.replaceAll('-', ' ')}</span><strong>{item.data.title}</strong><span>{item.data.description}</span></a></li>)}</ol>
    </section>

    <aside class="fieldwork-boundary-rail" aria-label="Inspiral fieldwork boundary"><p class="section-label">Fieldwork boundary</p><p>Inspiral Fieldwork records a developing investigation. It is not a product archive, a promise of future capability or a general performance claim. The <a href="/projects/inspiral/">Inspiral project page</a> carries the wider project context.</p></aside>
  </article>
</BaseLayout>
