---
import FieldworkArticle from '../../../../components/fieldwork/FieldworkArticle.astro';
import { getCollection, render } from 'astro:content';
import { isPublishedIndexable, isReviewNoindex } from '../../../../lib/fieldwork';

export async function getStaticPaths() {
  const items = await getCollection('fieldwork', ({ data }) => (isPublishedIndexable(data) || isReviewNoindex(data)) && data.project === 'inspiral');
  return items.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<FieldworkArticle item={item}><Content /></FieldworkArticle>
