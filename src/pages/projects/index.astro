---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/project-fieldwork-hubs.css';
import { collectionStructuredData } from '../../lib/structured-data';
---
<BaseLayout title="Projects" description="Explore Shiftby.pro projects on AI-assisted work, knowledge continuity, evidence-bounded systems and accountable judgement." activeSection="projects" ogImage={new URL('/images/social/shiftby-pro.png', Astro.site).href} ogImageAlt="Shiftby.pro independent fieldwork and active projects" twitterCard="summary_large_image" structuredData={collectionStructuredData(Astro.site, '/projects/', 'Projects | Shiftby.pro', 'Independent explorations into AI-assisted work, knowledge continuity and accountable judgement.', [{ name: 'Inspiral', url: new URL('/projects/inspiral/', Astro.site).href }])}>
  <article class="page-shell directory-page">
    <header class="page-intro directory-intro">
      <p class="kicker">Project directory</p>
      <h1>Projects</h1>
      <p class="lede">Independent explorations into how AI-assisted work can retain context, evidence and accountable judgement.</p>
      <div class="hero-actions"><a class="arrow-link" href="/">Back to Shiftby.pro home</a><a class="arrow-link" href="/fieldwork/">Browse Fieldwork</a></div>
    </header>

    <section class="project-directory" aria-labelledby="current-projects">
      <p id="current-projects" class="section-label">Current projects</p>
      <div class="project-directory-list">
        <article class="project-directory-row">
          <p class="project-number" aria-hidden="true">01</p>
          <div class="project-directory-copy">
            <p class="section-label">Exploration · Active</p>
            <h2><a href="/projects/inspiral/">Inspiral</a></h2>
            <p>Persistent understanding for AI-assisted work.</p>
          </div>
          <nav class="project-directory-actions" aria-label="Inspiral links">
            <a class="arrow-link" href="/projects/inspiral/">Explore project</a>
            <a class="arrow-link" href="/fieldwork/?project=inspiral">Read Inspiral Fieldwork</a>
          </nav>
        </article>

        <article class="project-directory-row project-directory-row-muted">
          <p class="project-number" aria-hidden="true">02</p>
          <div class="project-directory-copy">
            <p class="section-label">Practice · In progress</p>
            <h2>AI Security Assurance</h2>
            <p>Repository-grounded assurance, testing and accountable AI engineering.</p>
          </div>
          <p class="status-label">Project page to follow</p>
        </article>
      </div>
    </section>

    <aside class="directory-relationship" aria-label="How projects and fieldwork relate">
      <p class="section-label">How this directory works</p>
      <p>Projects carry an inquiry forward. Fieldwork records the observations, methods, evidence and limits encountered while pursuing it.</p>
    </aside>
  </article>
</BaseLayout>
