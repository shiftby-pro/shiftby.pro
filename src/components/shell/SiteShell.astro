---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SEO from '../seo/SEO.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeSection?: 'projects' | 'fieldwork' | 'about' | '';
  author?: string;
  type?: string;
  seoTitle?: string;
  ogTitle?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description = 'Independent fieldwork on AI-assisted research, systems and practice.', activeSection = '', author = 'Ananda Krishna Marri', type = 'website', seoTitle, ogTitle, ogImage, ogImageAlt, twitterCard, robots, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = seoTitle ?? (title === 'Shiftby.pro' ? title : `${title} | Shiftby.pro`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f8f5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="Shiftby.pro Fieldwork" href="/feed.xml" />
    <SEO title={pageTitle} description={description} canonical={canonical} author={author} type={type} ogTitle={ogTitle} ogImage={ogImage} ogImageAlt={ogImageAlt} twitterCard={twitterCard} robots={robots} structuredData={structuredData} />
  </head>
  <body>
    <SiteHeader activeSection={activeSection} />
    <main id="main-content"><slot /></main>
    <SiteFooter />
  </body>
</html>
