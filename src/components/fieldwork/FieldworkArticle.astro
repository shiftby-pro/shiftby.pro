---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { FieldworkEntry } from '../../lib/fieldwork';
import { getFieldworkCanonicalPath, getSeriesName } from '../../lib/fieldwork';

interface Props {
  item: FieldworkEntry;
}

const { item } = Astro.props;
const canonicalPath = getFieldworkCanonicalPath(item);
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const authorName = item.data.author.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const authorUrl = new URL('/about/', Astro.site).href;
const projectName = item.data.project?.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const projectPath = item.data.project ? `/projects/${item.data.project}/` : undefined;
const collectionPath = item.data.project ? `${projectPath}fieldwork/` : '/fieldwork/';
const collectionUrl = new URL(collectionPath, Astro.site).href;
const description = item.data.seo_description ?? item.data.description;
const sourceSeoTitle = item.data.seo_title ?? item.data.title;
const seoTitle = sourceSeoTitle.includes('Shiftby.pro') ? sourceSeoTitle : `${sourceSeoTitle} | Shiftby.pro`;
const publishedIso = item.data.published_at?.toISOString();
const modifiedIso = (item.data.updated_at ?? item.data.published_at)?.toISOString();
const showUpdated = Boolean(item.data.updated_at && item.data.updated_at.getTime() !== item.data.published_at?.getTime());
const representativeImageUrl = new URL(item.data.images.representative.src, Astro.site).href;
const representativeImageId = `${canonicalUrl}#representative-image`;
const socialImageUrl = new URL(item.data.images.social.src, Astro.site).href;

const formatDate = (date?: Date) => date?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const statusLabels: Record<FieldworkEntry['data']['current_status'], string> = {
  current: 'Current',
  historical: 'Historical',
  'mixed-qualified': 'Mixed / qualified',
  'unknown-verify': 'Verify current state',
  superseded: 'Superseded',
};
const purposeLabels: Record<FieldworkEntry['data']['editorial_purpose'], string> = {
  analyze: 'Analysis', explain: 'Explanation', document: 'Documentation', teach: 'Teaching', report: 'Report', reflect: 'Reflection',
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  ...(item.data.project && projectName && projectPath ? [{ name: projectName, path: projectPath }] : []),
  { name: getSeriesName(item), path: collectionPath },
  { name: item.data.title, path: canonicalPath },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${authorUrl}#author`,
      name: authorName,
      url: authorUrl,
    },
    {
      '@type': 'CollectionPage',
      '@id': collectionUrl,
      name: getSeriesName(item),
      url: collectionUrl,
    },
    {
      '@type': 'ImageObject',
      '@id': representativeImageId,
      url: representativeImageUrl,
      contentUrl: representativeImageUrl,
      caption: item.data.images.representative.alt,
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: item.data.title,
      isPartOf: { '@id': collectionUrl },
      primaryImageOfPage: { '@id': representativeImageId },
    },
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      url: canonicalUrl,
      headline: item.data.title,
      description,
      ...(publishedIso ? { datePublished: publishedIso } : {}),
      ...(modifiedIso ? { dateModified: modifiedIso } : {}),
      author: { '@id': `${authorUrl}#author` },
      publisher: { '@id': `${authorUrl}#author` },
      image: { '@id': representativeImageId },
      mainEntityOfPage: { '@id': canonicalUrl },
      isPartOf: { '@id': collectionUrl },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, Astro.site).href,
      })),
    },
  ],
};
---
<BaseLayout
  title={item.data.title}
  seoTitle={seoTitle}
  description={description}
  activeSection="fieldwork"
  type="article"
  ogImage={socialImageUrl}
  ogImageAlt={item.data.images.social.alt}
  twitterCard="summary_large_image"
  robots={item.data.indexing === 'noindex' ? 'noindex, follow' : undefined}
  structuredData={structuredData}
>
  <article class="article">
    <nav class="article-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumbs.slice(0, -1).map((crumb) => (
          <li>
            <a href={crumb.path}>{crumb.name}</a>
          </li>
        ))}
      </ol>
    </nav>
    <header class="article-header">
      <p class="eyebrow">{getSeriesName(item)} / {purposeLabels[item.data.editorial_purpose]} · {item.data.format.replaceAll('-', ' ')}</p>
      <h1>{item.data.title}</h1>
      <p class="lede">{item.data.description}</p>
      <dl class="meta article-publication-meta">
        <div><dt>Project</dt><dd>{projectPath && projectName ? <a href={projectPath}>{projectName}</a> : 'Shiftby.pro'}</dd></div>
        <div><dt>Work domains</dt><dd>{item.data.work_domains.map((domain) => domain.replaceAll('-', ' ')).join(', ')}</dd></div>
        <div><dt>Practice area</dt><dd>{item.data.practice_area.replaceAll('-', ' ')}</dd></div>
        {item.data.published_at && <div><dt>Published</dt><dd><time datetime={publishedIso}>{formatDate(item.data.published_at)}</time></dd></div>}
        {showUpdated && <div><dt>Updated</dt><dd><time datetime={modifiedIso}>{formatDate(item.data.updated_at)}</time></dd></div>}
        <div><dt>Current status</dt><dd>{statusLabels[item.data.current_status]}</dd></div>
        <div><dt>Publication</dt><dd>{item.data.published_status.replaceAll('-', ' ')}</dd></div>
        <div><dt>Author</dt><dd><a href="/about/" rel="author">{authorName}</a></dd></div>
      </dl>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
