  {name === 'network' && <><circle cx="6" cy="12" r="2" /><circle cx="17.5" cy="5.5" r="2" /><circle cx="18" cy="18" r="2" /><path d="m7.7 10.9 8.1-4.4M7.9 13.1l8.2 4" /></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="8.5" /><path d="m15.8 8.2-2.2 4.8-4.8 2.2 2.2-4.8z" /><circle cx="12" cy="12" r=".8" fill="currentColor" /></>}
  {name === 'task' && <><path d="M6 6h12M6 12h12M6 18h7" /><path d="m3.8 6 .9.9 1.7-1.8M3.8 12l.9.9 1.7-1.8M3.8 18l.9.9 1.7-1.8" /></>}
  {name === 'skill' && <><path d="M12 3.5 19 7v5c0 4.2-2.8 7.1-7 8.5C7.8 19.1 5 16.2 5 12V7z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'tools' && <><path d="M7 5h10v6H7zM5 17h14v3H5zM9 11v6M15 11v6" /><circle cx="12" cy="8" r="1" /></>}
  {name === 'result' && <><rect x="6" y="3.5" width="12" height="17" rx="1" /><path d="M9 8h6M9 12h6M9 16h4" /></>}
  {name === 'validate' && <><path d="M12 3.5 19 7v5c0 4.2-2.8 7.1-7 8.5C7.8 19.1 5 16.2 5 12V7z" /><path d="m8.5 12 2.3 2.3 4.8-5" /></>}
  {name === 'sync' && <><path d="M6 8a7 7 0 0 1 11.4-2.1L19 7.5M18 16a7 7 0 0 1-11.4 2.1L5 16.5" /><path d="M19 4.5v3h-3M5 19.5v-3h3" /></>}
  {name === 'budget' && <><path d="M5 8.5h14v11H5zM8 8.5V6h8v2.5M8 13h8M8 16h5" /></>}
  {name === 'cost' && <><circle cx="12" cy="12" r="8.5" /><path d="M14.5 9.5c-.5-.7-1.3-1-2.4-1-1.4 0-2.4.7-2.4 1.8 0 2.8 5.3 1.2 5.3 4.2 0 1.1-1 2-2.7 2-1.1 0-2.1-.4-2.8-1.2M12 6.8v10.4" /></>}
  {name === 'repair' && <><path d="M14.5 5.5a4 4 0 0 0-5.1 5.1L4.5 15.5a2 2 0 0 0 2.8 2.8l4.9-4.9a4 4 0 0 0 5.1-5.1l-2.5 2.5-2.2-.6-.6-2.2z" /></>}
  {name === 'chat' && <><path d="M4.5 5.5h15v10h-9l-4 3v-3h-2z" /><path d="M8 9h8M8 12h5" /></>}
